\f1\b0\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Valid\'e1 todas las emociones que aparecen durante la adaptaci\'f3n escolar. Sentir miedo, entusiasmo o tristeza es completamente normal.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Record\'e1 que cada ni\'f1o necesita un tiempo diferente para adaptarse.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Manten\'e9 rutinas claras y predecibles que brinden seguridad.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Despedite siempre del ni\'f1o con tranquilidad, evitando irte sin avisar.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Transmit\'ed confianza hacia la instituci\'f3n y los docentes.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Evit\'e1 prolongar excesivamente las despedidas, ya que pueden aumentar la ansiedad.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Escuch\'e1 lo que el ni\'f1o quiera contar sobre su d\'eda, sin presionarlo con demasiadas preguntas.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Celebr\'e1 cada peque\'f1o logro durante el proceso de adaptaci\'f3n.\
\ls8\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Record\'e1 que la adaptaci\'f3n no consiste en dejar de extra\'f1ar, sino en aprender que es posible sentirse seguro mientras espera el reencuentro con su familia.\
\pard\pardeftab720\partightenfactor0
