\f1\b\fs48 \cf0 \strokec2 7. Actividades pr\'e1cticas\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 \strokec2 Practicamos el cepillado\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 Frente al espejo, acompa\'f1ar al ni\'f1o durante el cepillado, mostrando movimientos suaves sobre todas las superficies de los dientes.\
Convertir el momento en un espacio compartido y agradable.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

