\f0\b\fs36 \cf0 \strokec2 7. Actividades pr\'e1cticas\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 B\'fasqueda del tesoro\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Esconder un objeto sencillo dentro del aula o de la casa y preparar peque\'f1as pistas visuales o muy simples.\
Los ni\'f1os deber\'e1n buscarlo colaborando entre todos, conversando y observando juntos.\
El objetivo es que todos participen y lleguen juntos al descubrimiento.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 \strokec2 Somos exploradores\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Preparar mochilas con objetos de exploraci\'f3n:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
